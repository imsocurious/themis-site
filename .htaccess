# Themis Expert – configurare Apache (cPanel), securitate conform recomandărilor OWASP actuale

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.html index.php
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
FileETag None

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Doar metodele necesare (blochează TRACE, PUT, DELETE etc.)
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$
  RewriteRule ^ - [R=405,L]
  # Forțează HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Fără www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # PHP este permis doar pentru formularul de contact
  RewriteCond %{REQUEST_URI} \.(php[0-9]?|phtml|phar)$ [NC]
  RewriteCond %{REQUEST_URI} !^/contact\.php$
  RewriteRule ^ - [R=404,L]
</IfModule>

# Blochează fișierele interne și ascunse (cu excepția /.well-known pentru certificate și security.txt)
<FilesMatch "(^\.|^README|^GHID|\.(md|yml|yaml|json|log|ini|sh|sql|bak|old|orig|swp|dist|lock|env)$|~$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Transport: doar HTTPS timp de 2 ani
  Header always set Strict-Transport-Security "max-age=63072000"
  # Politica de conținut: nimic din afara site-ului, fără scripturi inline, fără încadrare în alte site-uri
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header always set Origin-Agent-Cluster "?1"
  Header always unset X-Powered-By
  Header unset X-Powered-By
  Header always unset Server

  # Paginile nu se păstrează în cache (conținut mereu actual), resursele statice da
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

AddType font/woff2 .woff2
AddDefaultCharset utf-8
AddCharset utf-8 .html .css .js .svg .txt
